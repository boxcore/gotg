# ==============================================================================
# gotg 配置模板 (.env)
# ==============================================================================
# 使用方法：复制本文件为 .env 并填入你自己的配置
# cp .env.example .env
# ==============================================================================

# Telegram Bot Token (多个 Token 可用逗号 "," 分隔)
TOKEN=12345678:AAHdU-Z25K2D7YDMvS997v818wA8tQFg8G0

# 目标频道的用户名(带@)或ID(如-100xxx)
CHAT_ID=@mychannel

# 自定义 Telegram Bot API Server URL (可空，为空时使用官方 API 限额 50MB；非空使用自定义限制 2GB)
API_URL=http://149.104.4.30:8081
