# ==============================================================================
# gotg .gitignore
# ==============================================================================

# 编译生成的可执行二进制文件
gotg
gotg.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试生成的二进制文件
*.test

# Go 覆盖率报告
*.out

# 本地私密配置文件（包含 Token，切勿提交！）
.env

# 个人 IDE / 编辑器配置
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统临时文件
.DS_Store
Thumbs.db
